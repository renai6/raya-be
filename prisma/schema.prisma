// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                String    @id @default(cuid())
  active_session_id String?   @unique
  name              String
  contactNumber     String?
  email             String    @unique
  password          String
  activeSessionId   String?
  lastLoginAt       DateTime?
  role              Role      @default(CASHIER)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model Employee {
  id             String        @id @default(cuid())
  employeeNumber String        @unique
  name           String
  contactNumber  String?
  email          String?
  isDeleted      Boolean       @default(false)
  transactions   Transaction[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

enum Role {
  ADMIN
  MANAGER
  CASHIER
}

enum TransactionPaymentType {
  CASH
  CREDIT
}

enum InventoryTransactionType {
  PURCHASE
  ADJUSTMENT
  RETURN
}

model Product {
  id                    String                 @id @default(cuid())
  name                  String
  barcode               String                 @unique
  retailPrice           Float
  wholesalePrice        Float
  stock                 Int
  isDeleted             Boolean                @default(false)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  sales                 Sale[]
  inventoryTransactions InventoryTransaction[]
}

enum SaleType {
  RETAIL
  WHOLESALE
}

model Transaction {
  id             String                 @id @default(cuid())
  sales          Sale[]
  total          Float
  cashReceived   Float                  @default(0)
  employeeNumber String?
  paymentType    TransactionPaymentType @default(CASH)
  createdAt      DateTime               @default(now())
  employee       Employee?              @relation(fields: [employeeId], references: [id])
  employeeId     String?
}

model InventoryTransaction {
  id                String                   @id @default(cuid())
  type              InventoryTransactionType @default(PURCHASE)
  productId         String
  oldQuantity       Int
  newQuantity       Int
  oldRetailPrice    Float
  newRetailPrice    Float
  oldWholesalePrice Float
  newWholesalePrice Float
  reason            String?
  product           Product                  @relation(fields: [productId], references: [id])
  createdAt         DateTime                 @default(now())
}

model Sale {
  id            String      @id @default(cuid())
  productId     String
  transactionId String
  quantity      Int
  total         Float
  saleType      SaleType    @default(RETAIL)
  createdAt     DateTime    @default(now())
  product       Product     @relation(fields: [productId], references: [id])
  transaction   Transaction @relation(fields: [transactionId], references: [id])
}
